---
import BaseLayout from './BaseLayout.astro';
import TagPill from '../components/TagPill.astro';
import type { Post } from '../lib/posts';
import { formatDate } from '../lib/posts';
import { postUrl } from '../lib/url';

interface Props {
  post: Post;
  prev?: Post | null;
  next?: Post | null;
}

const { post, prev = null, next = null } = Astro.props;
const { title, date, updated, summary, tags } = post.data;
---

<BaseLayout title={title} description={summary ?? title} type="article">
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <span>更新于 {formatDate(updated)}</span>}
      </div>
      {
        tags.length > 0 && (
          <div class="tag-list">
            {tags.map((tag) => (
              <TagPill tag={tag} />
            ))}
          </div>
        )
      }
    </header>

    <div class="post-body">
      <slot />
    </div>
  </article>

  {
    (prev || next) && (
      <nav class="post-nav" aria-label="文章导航">
        {prev ? (
          <a href={postUrl(prev.id)}>
            <span aria-hidden="true">← </span>上一篇：{prev.data.title}
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a class="next" href={postUrl(next.id)}>
            下一篇：{next.data.title}
            <span aria-hidden="true"> →</span>
          </a>
        )}
      </nav>
    )
  }
</BaseLayout>
