---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectTags, getPublishedPosts } from '../../lib/posts';
import { tagUrl } from '../../lib/url';

const posts = await getPublishedPosts();
const tags = collectTags(posts);
---

<BaseLayout title="标签">
  <h1 class="page-title">标签</h1>
  <p class="page-subtitle">共 {tags.length} 个标签，按文章数排序。</p>

  {
    tags.length === 0 ? (
      <p class="empty">还没有标签。</p>
    ) : (
      <ul class="tag-cloud">
        {tags.map(({ tag, count }) => (
          <li>
            <a href={tagUrl(tag)}>
              #{tag}
              <span class="count">{count}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
