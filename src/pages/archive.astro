---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts } from '../lib/posts';
import { postUrl } from '../lib/url';

const posts = await getPublishedPosts();

const byYear = new Map<string, typeof posts>();
for (const post of posts) {
  const year = formatDate(post.data.date).slice(0, 4);
  const group = byYear.get(year);
  if (group) {
    group.push(post);
  } else {
    byYear.set(year, [post]);
  }
}

const years = [...byYear.entries()].sort((a, b) => Number(b[0]) - Number(a[0]));
---

<BaseLayout title="归档">
  <h1 class="page-title">归档</h1>
  <p class="page-subtitle">共 {posts.length} 篇，按年份分组。</p>

  {
    years.length === 0 ? (
      <p class="empty">还没有文章。</p>
    ) : (
      years.map(([year, items]) => (
        <section class="year-group">
          <h2>{year}</h2>
          <ul class="archive-list">
            {items.map((post) => (
              <li>
                <a href={postUrl(post.id)}>{post.data.title}</a>
                <span class="date">{formatDate(post.data.date).slice(5)}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    )
  }
</BaseLayout>
